# Environment Variables — copy this to .env and fill in your values
# NEVER commit your real .env file to git

# ── Database (PostgreSQL — only if you switch from SQLite) ────────────────────
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
